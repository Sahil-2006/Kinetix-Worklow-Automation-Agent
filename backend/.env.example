# Local runtime. Use production only with the strong secrets listed below.
APP_ENV=development

# PostgreSQL/Supabase connection string; required by the API.
DATABASE_URL=postgresql://postgres:password@localhost:5432/kinetix

# OpenRouter is required for natural-language workflows.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4

# Replace this development value before using a non-local deployment.
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_ACCESS_EXPIRE_MINUTES=30
JWT_REFRESH_EXPIRE_DAYS=7

# Generate a Fernet key for durable encrypted action records.
PII_ENCRYPTION_KEY=

# Relative file tools are restricted to this folder.
AGENT_DATA_DIR=./data

# Real email and calendar actions are simulated unless explicitly enabled.
ENABLE_LIVE_ACTIONS=false
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=agent@kinetix.dev
GOOGLE_CALENDAR_CREDENTIALS=
GOOGLE_CALENDAR_ID=primary
GOOGLE_CLIENT_ID=

# Comma-separated frontend origins.
CORS_ORIGINS=http://localhost:5173
MAX_REACT_ITERATIONS=10
REDIS_URL=
